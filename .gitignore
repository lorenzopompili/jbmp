*.log
logs/

# OS
.DS_Store
Thumbs.db

# Local-only config / secrets (real endpoints, credentials) — never commit
.env
*.env.local
application-local.yml
application-local.yaml
*-local.properties

# Local benchmarking & profiling artifacts — never commit. Throwaway scripts and captures

# jBMP environment configuration — EXAMPLE.
#
# Copy this file to `.env` and fill in your own endpoints/credentials. The real `.env` is
# git-ignored and must never be committed. These keys use Spring Boot's relaxed-binding
# environment-variable form, so they override the defaults in each module's application.yml when
# exported into the process environment before launch.
#
#   cp .env.example .env      # then edit, then: set -a; . ./.env; set +a   (bash)
#
# All values below are placeholders for a local setup.

# --- Kafka ---------------------------------------------------------------------------------------
# Comma-separated bootstrap servers the collector produces to and the consumer reads from.
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- PostgreSQL / TimescaleDB (consumer persistence) ---------------------------------------------
# The consumer's JDBC sink. TimescaleDB is optional: the schema works on vanilla PostgreSQL and
# the hypertable/compression migrations are no-ops when the extension is absent.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jbmp
SPRING_DATASOURCE_USERNAME=jbmp
SPRING_DATASOURCE_PASSWORD=change-me

# Apply the Flyway schema migrations on startup and use the PostgreSQL-backed store (otherwise the
# consumer runs with an in-memory store, useful for smoke tests).
SPRING_FLYWAY_ENABLED=true
JBMP_CONSUMER_STORE=jdbc

# --- Optional tuning -----------------------------------------------------------------------------
# Per-poll batch size (Kafka max.poll.records) and listener concurrency for the consumer.
# JBMP_CONSUMER_BATCH_SIZE=5000
# JBMP_CONSUMER_CONCURRENCY=12

# BMP TCP listen port for the collector.
# JBMP_COLLECTOR_BMP_PORT=1790
